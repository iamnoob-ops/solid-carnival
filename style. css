* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  touch-action: none; /* Prevents unwanted scrolling while drawing on iPad/Mobile */
}

body {
  font-family: Arial, sans-serif;
  background-color: #f4f6f9;
  color: #333;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

header {
  background-color: #4a90e2;
  color: white;
  text-align: center;
  padding: 1rem;
}

.container {
  display: flex;
  flex-direction: row;
  flex: 1;
  padding: 1rem;
  gap: 1rem;
}

@media (max-width: 768px) {
  .container {
    flex-direction: column;
  }
}

.reference-card, .canvas-card {
  background: white;
  border-radius: 8px;
  padding: 1rem;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.reference-card {
  flex: 1;
}

.reference-card img {
  max-width: 100%;
  max-height: 300px;
  border-radius: 6px;
  object-fit: contain;
  margin: 1rem 0;
}

.step-controls {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-top: auto;
}

.canvas-card {
  flex: 2;
  width: 100%;
}

.toolbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
  width: 100%;
}

button {
  padding: 8px 14px;
  border: none;
  background-color: #4a90e2;
  color: white;
  border-radius: 4px;
  cursor: pointer;
}

button:disabled {
  background-color: #ccc;
  cursor: not-allowed;
}

.canvas-wrapper {
  width: 100%;
  flex: 1;
  border: 2px dashed #ccc;
  border-radius: 6px;
  position: relative;
  min-height: 350px;
}

canvas {
  width: 100%;
  height: 100%;
  display: block;
}
